# Copy to .env; command-line options override these values.
# Relative paths are resolved from the directory where the command runs.
KUSAMA_CACHE_DIR=.cache/huggingface
KUSAMA_OUTPUT_DIR=artifacts

# auto chooses an available accelerator; explicit choices: cuda, mps, cpu.
KUSAMA_DEVICE=auto
# auto prefers BF16 where supported; explicit choices: bf16, fp16, fp32.
KUSAMA_PRECISION=auto
# none, model, or sequential. CPU offloading requires an accelerator (CUDA or MPS).
KUSAMA_OFFLOAD=none
KUSAMA_VAE_TILING=false

# Resolved immutable checkpoint revision; update deliberately for a new experiment.
KUSAMA_MODEL_REVISION=a3b4f4849157f664bdbc776fd7453c2783562f4d
# true uses only already-cached model files and does not download weights.
KUSAMA_LOCAL_FILES_ONLY=false

# Optional Hugging Face access token. Leave blank for public access.
# Never commit a populated .env or put a token in the run manifest.
HF_TOKEN=
